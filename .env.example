# コピーして .env.local を作成し、値を埋める（.env.local は Git に含めない）
# Vercel 本番: 同じ変数名を Project → Settings → Environment Variables に登録

# DB（Vercel / Prisma Postgres）— Prisma Client はいずれか必須
POSTGRES_URL=
PRISMA_DATABASE_URL=
# または DATABASE_URL=（POSTGRES_URL と同じ値でも可）

# microCMS（管理画面 → サービス設定 → API キー）
NEXT_PUBLIC_SERVICE_DOMAIN=
NEXT_PUBLIC_API_KEY=

# NextAuth（dev / start でも設定推奨）
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# 購入履歴 API（未実装なら空でよい）
NEXT_PUBLIC_API_URL=
